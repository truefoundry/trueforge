{
  "$schema": "https://mintlify.com",
  "theme": "mint",
  "name": "TrueForge",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://trueforge.dev"
  },
  "favicon": {
    "light": "/logo/favicon-light.svg",
    "dark": "/logo/favicon-dark.svg"
  },
  "description": "Open-source agent harness — MCP tools, skills, sandboxing, approvals, and subagents.",
  "colors": {
    "primary": "#4f46e5",
    "light": "#4f46e5",
    "dark": "#4f46e5"
  },
  "topbarLinks": [
    {
      "name": "Support",
      "url": "https://example.com"
    }
  ],
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "quickstart"]
          },
          {
            "group": "TrueForge Harness",
            "pages": [
              {
                "group": "Initial Setup",
                "pages": ["harness/initial-setup", "models", "mcp-servers", "skills", "sandbox"]
              },
              {
                "group": "Create an Agent",
                "pages": [
                  "create-agent/overview",
                  "create-agent/tool-approval",
                  "create-agent/ask-user-questions",
                  "create-agent/generative-ui",
                  "create-agent/agent-spec"
                ]
              },
              "agent-library",
              {
                "group": "Key Features",
                "pages": [
                  "key-features/overview",
                  "key-features/subagents",
                  "key-features/deferred-tool-loading",
                  "key-features/code-mode",
                  "key-features/large-tool-responses"
                ]
              },
              "benchmarking",
              "authentication/overview"
            ]
          },
          {
            "group": "SDK",
            "pages": ["api/overview", "api/use-agent", "api/turn-events"]
          },
          {
            "group": "Chat UI",
            "pages": ["chat-ui"]
          },
          {
            "group": "Project",
            "pages": ["roadmap"]
          }
        ]
      },
      {
        "tab": "UI SDK",
        "groups": [
          {
            "group": "Get started",
            "pages": ["ui-sdk/index", "ui-sdk/get-started/quickstart"]
          },
          {
            "group": "Frontend Customisation",
            "pages": [
              "ui-sdk/guides/layouts",
              "ui-sdk/guides/layouts-and-theme",
              "ui-sdk/guides/agent-modes",
              "ui-sdk/setup-custom-ui/custom-theme",
              "ui-sdk/guides/troubleshooting"
            ]
          },
          {
            "group": "Server Customisations",
            "pages": [
              "ui-sdk/setup-custom-servers/connect-with-truefoundry",
              "ui-sdk/setup-custom-servers/custom-server",
              "ui-sdk/setup-custom-servers/server-contract"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "ui-sdk/reference/trueforge-ui",
              "ui-sdk/reference/theme",
              "ui-sdk/reference/containers",
              "ui-sdk/reference/atoms",
              "ui-sdk/reference/hooks",
              "ui-sdk/reference/server",
              "ui-sdk/reference/events",
              "ui-sdk/reference/catalog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": {
          "source": "./openapi.json",
          "directory": "docs/api-reference"
        }
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/truefoundry/trueforge"
      }
    ],
    "primary": {
      "type": "button",
      "label": "TrueFoundry",
      "href": "https://www.truefoundry.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/truefoundry",
      "x": "https://x.com/truefoundry",
      "linkedin": "https://in.linkedin.com/company/truefoundry"
    }
  }
}
