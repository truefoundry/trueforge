{
  "name": "@truefoundry/utils",
  "version": "0.1.7",
  "description": "TrueFoundry agent core and session library",
  "author": "Truefoundry",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./core": {
      "development": {
        "types": "./src/core/index.ts",
        "default": "./src/core/index.ts"
      },
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.cjs",
      "default": "./dist/core/index.js"
    },
    "./agent-session": {
      "development": {
        "types": "./src/agent-session/index.ts",
        "default": "./src/agent-session/index.ts"
      },
      "types": "./dist/agent-session/index.d.ts",
      "require": "./dist/agent-session/index.cjs",
      "default": "./dist/agent-session/index.js"
    },
    "./request-reply": {
      "development": {
        "types": "./src/request-reply/index.ts",
        "default": "./src/request-reply/index.ts"
      },
      "types": "./dist/request-reply/index.d.ts",
      "require": "./dist/request-reply/index.cjs",
      "default": "./dist/request-reply/index.js"
    },
    "./*.mjs": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.cjs": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.cjs"
    },
    "./*": {
      "development": {
        "types": "./src/*.ts",
        "default": "./src/*.ts"
      },
      "types": "./dist/*.d.ts",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:gen && tsc --noEmit && pnpm run build:js && pnpm run build:dts && pnpm run build:pkg && pnpm run build:check",
    "build:gen": "node scripts/generate-sandbox-scripts.mjs",
    "build:js": "tsup",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:pkg": "node scripts/make-dist-package-json.mjs",
    "build:check": "node scripts/check-dist.mjs",
    "typecheck": "pnpm run build:gen && tsc --noEmit",
    "test": "pnpm run build:gen && jest --config jest.config.cjs",
    "pack:dry": "cd dist && pnpm pack --dry-run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.25",
    "@ai-sdk/google": "^4.0.29",
    "@ai-sdk/mistral": "^4.0.18",
    "@ai-sdk/openai": "^4.0.25",
    "@ai-sdk/openai-compatible": "^3.0.18",
    "@daytona/sdk": "^0.190.0",
    "@hono/zod-openapi": "^0.19.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nats-io/nats-core": "3.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.9.0",
    "ai": "^7.0.44",
    "dedent": "^1.7.2",
    "openai": "^4.104.0",
    "ulid": "^3.0.2",
    "winston": "^3.13.0",
    "ws": "^8.21.0",
    "zod": "^3.24.3",
    "zod-to-json-schema": "^3.25.1"
  },
  "peerDependencies": {
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.0",
    "@types/ws": "^8.5.10",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "jest": "^29.7.0",
    "redis": "^5.10.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  }
}
