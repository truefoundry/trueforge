{
    "name": "trueforge",
    "version": "0.0.0",
    "private": false,
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./serialization": {
            "import": {
                "types": "./dist/esm/serialization/index.d.mts",
                "default": "./dist/esm/serialization/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/serialization/index.d.ts",
                "default": "./dist/cjs/serialization/index.js"
            },
            "default": "./dist/cjs/serialization/index.js"
        },
        "./server": {
            "import": {
                "types": "./dist/esm/api/resources/server/exports.d.mts",
                "default": "./dist/esm/api/resources/server/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/server/exports.d.ts",
                "default": "./dist/cjs/api/resources/server/exports.js"
            },
            "default": "./dist/cjs/api/resources/server/exports.js"
        },
        "./mcpServers": {
