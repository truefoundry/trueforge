        },
        "./settings/skills": {
            "import": {
                "types": "./dist/esm/api/resources/settings/resources/skills/exports.d.mts",
                "default": "./dist/esm/api/resources/settings/resources/skills/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/settings/resources/skills/exports.d.ts",
                "default": "./dist/cjs/api/resources/settings/resources/skills/exports.js"
            },
            "default": "./dist/cjs/api/resources/settings/resources/skills/exports.js"
