            },
            "default": "./dist/cjs/api/resources/mcpServers/exports.js"
        },
        "./models": {
            "import": {
                "types": "./dist/esm/api/resources/models/exports.d.mts",
                "default": "./dist/esm/api/resources/models/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/models/exports.d.ts",
                "default": "./dist/cjs/api/resources/models/exports.js"
            },
            "default": "./dist/cjs/api/resources/models/exports.js"
        },
        "./sessions": {
            "import": {
                "types": "./dist/esm/api/resources/sessions/exports.d.mts",
