                "default": "./dist/esm/api/resources/skills/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/skills/exports.d.ts",
                "default": "./dist/cjs/api/resources/skills/exports.js"
            },
            "default": "./dist/cjs/api/resources/skills/exports.js"
        },
        "./settings": {
            "import": {
                "types": "./dist/esm/api/resources/settings/exports.d.mts",
                "default": "./dist/esm/api/resources/settings/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/settings/exports.d.ts",
