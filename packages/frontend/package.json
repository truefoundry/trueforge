{
  "name": "frontend",
  "version": "0.0.0",
  "description": "TrueFoundry agent chat frontend (draft-only). Private app — not published to npm.",
  "author": "Truefoundry",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "sdk:build": "pnpm --pm-on-fail=ignore --dir ../sdk install --ignore-scripts && pnpm --pm-on-fail=ignore --dir ../sdk build",
    "predev": "pnpm run sdk:build",
    "dev": "trap 'exit 0' INT TERM; vite",
    "dev:no-watch": "pnpm run dev",
    "prebuild": "pnpm run sdk:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm run sdk:build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run sdk:build",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@assistant-ui/core": "0.2.22",
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/store": "0.2.21",
    "@truefoundry/agent-ui-sdk": "^0.1.3",
    "@truefoundry/assistant-ui-runtime": "^0.1.7",
    "monaco-editor": "^0.52.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "trueharness": "link:../sdk"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-monaco-editor-esm": "^2.0.2"
  }
}
