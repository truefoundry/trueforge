{
  "name": "frontend",
  "version": "0.0.0",
  "description": "TrueForge agent chat frontend. Private app — not published to npm.",
  "author": "TrueFoundry",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sdk:build": "pnpm --filter @truefoundry/trueforge-sdk build",
    "ui:build": "pnpm --filter @truefoundry/trueforge-ui build",
    "predev": "pnpm run sdk:build && pnpm run ui:build",
    "dev": "trap 'exit 0' INT TERM; vite",
    "dev:no-watch": "pnpm run dev",
    "prebuild": "pnpm run sdk:build && pnpm run ui:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm run sdk:build && pnpm run ui:build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run sdk:build && pnpm run ui:build",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@assistant-ui/core": "0.2.22",
    "@assistant-ui/react": "^0.14.29",
    "@assistant-ui/store": "0.2.21",
    "@truefoundry/assistant-ui-runtime": "0.1.21",
    "@truefoundry/trueforge-sdk": "workspace:*",
    "@truefoundry/trueforge-ui": "workspace:*",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-monaco-editor-esm": "^2.0.3"
  }
}
