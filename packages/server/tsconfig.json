{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*", "tsup.config.ts"],
  // Test bodies pull harness test sources across the package boundary, which needs
  // that package's own compiler paths; support modules stay in-project.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "tests/**/*.test.ts"]
}
