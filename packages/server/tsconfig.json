{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "noEmit": true,
    "customConditions": ["development"],
    "paths": {
      "openai/resources/chat": ["../harness/node_modules/openai/resources/chat/index.d.ts"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "tsup.config.ts"],
  // node:test files under src/ stay out of the Jest-typed project.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
