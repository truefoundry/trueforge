{
  "name": "@truefoundry/server",
  "version": "0.1.0",
  "description": "TrueFoundry agent server (CLI/HTTP). Not published yet.",
  "author": "Truefoundry",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsx --env-file=.env src/main.ts",
    "migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "openapi:write": "tsx --env-file=.env.test scripts/write-openapi.ts",
    "test": "tsx --env-file=.env.test --test src/**/*.test.ts",
    "test:store": "jest --config jest.store.config.cjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@hono/swagger-ui": "^0.2.1",
    "@hono/zod-openapi": "^0.19.10",
    "@truefoundry/utils": "workspace:*",
    "hono": "^4.12.31",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "redis": "^5.10.0",
    "ulid": "^3.0.2",
    "winston": "^3.13.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "tsup": "^8.5.0",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2"
  }
}
