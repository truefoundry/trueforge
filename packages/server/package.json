{
  "name": "@truefoundry/server",
  "version": "0.1.0",
  "description": "TrueFoundry agent server (CLI/HTTP). Not published yet.",
  "author": "Truefoundry",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build:gen": "node scripts/generate-catalog.mjs",
    "build:gen:watch": "node --watch-path=src/catalog/model-catalog.yaml --watch-path=src/catalog/mcp-catalog.yaml --watch-path=src/catalog/skill-catalog.yaml --watch-path=src/catalog/sandbox-catalog.yaml scripts/generate-catalog.mjs",
    "build": "pnpm run build:gen && tsc --noEmit && tsup",
    "predev": "pnpm --filter @truefoundry/utils-core build:gen && pnpm run build:gen",
    "dev": "pnpm run --parallel catalog-watch dev:serve",
    "catalog-watch": "pnpm run build:gen:watch",
    "dev:serve": "NODE_OPTIONS='--conditions=development' NODE_ENV=development tsx watch --env-file=.env src/main.ts",
    "predev:no-watch": "pnpm --filter @truefoundry/utils-core build:gen && pnpm run build:gen",
    "dev:no-watch": "NODE_OPTIONS='--conditions=development' NODE_ENV=production tsx --env-file=.env src/main.ts",
    "migrate": "NODE_OPTIONS='--conditions=development' tsx --env-file=.env src/db/postgres/migrate-cli.ts",
    "typecheck": "pnpm run build:gen && tsc --noEmit && tsc --noEmit -p tests/db/tsconfig.json && tsc --noEmit -p tests/unit/tsconfig.json",
    "openapi:write": "pnpm run build:gen && NODE_OPTIONS='--conditions=development' tsx --env-file=.env.test scripts/write-openapi.ts",
    "test": "pnpm run build:gen && NODE_OPTIONS='--conditions=development' node --env-file=.env.test ./node_modules/jest/bin/jest.js --config jest.unit.config.cjs",
    "test:store:postgres": "jest --config jest.store.postgres.config.cjs",
    "test:store:sqlite": "jest --config jest.store.sqlite.config.cjs",
    "test:eventsub": "jest --config jest.eventsub.config.cjs"
  },
  "dependencies": {
    "@daytona/sdk": "^0.190.0",
    "@hono/node-server": "^2.0.11",
    "@hono/swagger-ui": "^0.2.1",
    "@hono/zod-openapi": "^1.5.1",
    "@truefoundry/utils-core": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "hono": "^4.12.34",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "redis": "^5.10.0",
    "ulid": "^3.0.2",
    "winston": "^3.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.37",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "tsup": "^8.5.0",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2"
  }
}
