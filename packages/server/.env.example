# ---------------------------------------------------------------------------
# Public agent server environment
#
# Copy to .env and fill in the values. The server validates all of these at
# startup and refuses to boot on any invalid value (bad JSON, bad URL, etc.).
#
# Topology (STANDALONE) and NODE_ENV are set by root pnpm scripts
# (`pnpm dev`, `pnpm standalone:dev`, `pnpm start`, …). Those process env
# values win over this file. Uncomment STANDALONE below only when running the
# server package directly (e.g. `node dist/main.js` or `tsx src/main.ts`).
# ---------------------------------------------------------------------------

# HTTP port the server listens on. Optional, defaults to 8790.
PORT=8790

# Optional override for the model catalog YAML (GET /settings/model-providers/catalog).
# When unset, the catalog inlined at build time (src/catalog/model-catalog.yaml) is used.
# MODEL_CATALOG_PATH=/path/to/model-catalog.yaml

# Optional override for the MCP catalog YAML (GET /settings/mcp-servers/catalog).
# When unset, the catalog inlined at build time (src/catalog/mcp-catalog.yaml) is used.
# MCP_CATALOG_PATH=/path/to/mcp-catalog.yaml

# Optional override for the skill catalog YAML (GET /settings/skills/catalog).
# When unset, the catalog inlined at build time (src/catalog/skill-catalog.yaml) is used.
# SKILL_CATALOG_PATH=/path/to/skill-catalog.yaml

# Optional override for the sandbox catalog YAML (GET /settings/sandbox-providers/catalog).
# When unset, the catalog inlined at build time (src/catalog/sandbox-catalog.yaml) is used.
# SANDBOX_CATALOG_PATH=/path/to/sandbox-catalog.yaml

# Frontend build the server serves alongside the API. Optional; defaults to
# packages/server/dist/_frontend (after build) or monorepo packages/frontend/dist.
# With no build there the server logs a warning and serves the API only.
# FRONTEND_DIR=/absolute/path/to/frontend/dist

# Deployment topology: single process (true, default) uses SQLite and
# disables Redis/executor peering; false uses Postgres + Redis so cancels
# that land on the wrong replica still work. Prefer root scripts
# (`pnpm standalone:*` vs `pnpm dev` / `pnpm start`) over setting this here.
# STANDALONE=false

# Absolute path to the SQLite database file. Used when STANDALONE=true;
# defaults to the OS data dir from env-paths (app name "truefoundry-utils"):
#   macOS: ~/Library/Application Support/truefoundry-utils/db.sqlite
#   Linux: ~/.local/share/truefoundry-utils/db.sqlite
#   Windows: %LOCALAPPDATA%\truefoundry-utils\Data\db.sqlite
# SQLITE_PATH=

# Used when STANDALONE=false (ignored in standalone). Redis connection URL for
# executor peering. Defaults to redis://localhost:6379 if unset.
# `docker-compose.yml` overrides this to redis://redis:6379 for the server container.
REDIS_URL=redis://localhost:6379

# Resumable turn stream settings. All are optional.
# Active stream TTL defaults to SERVER_EXECUTION_TIMEOUT_SECONDS + 300.
# TURN_STREAM_TTL_SECONDS=900
# Completed streams remain available for 5 minutes by default.
# TURN_STREAM_POST_COMPLETION_TTL_SECONDS=300
# A subscribe request stays open for 10 minutes by default.
# TURN_SUBSCRIBE_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# MCP OAuth (DCR). PUBLIC_BASE_URL is the origin of the fixed callback route
# {PUBLIC_BASE_URL}/api/v1/mcp-servers/oauth/callback (not trimmed). Optional;
# defaults to http://localhost:${PORT}. OAUTH_CLIENT_NAME is the RFC 7591
# client_name on the consent screen (default: truefoundry-harness).
# ---------------------------------------------------------------------------
# PUBLIC_BASE_URL=http://localhost:8790
# OAUTH_CLIENT_NAME=truefoundry-harness

# ---------------------------------------------------------------------------
# Sandbox process knobs. Provider identity/credentials are configured via
# PUT /api/v1/settings/sandbox-providers (copy from GET .../catalog). Without a
# configured provider, agent specs with config.sandbox.enabled (or skills) are
# rejected at session creation.
# ---------------------------------------------------------------------------

# Max bytes for a single file download out of the sandbox. Default 20 MB (same as gateway).
# SANDBOX_FILE_MAX_BYTES_FOR_DOWNLOAD=20971520

# ---------------------------------------------------------------------------
# Postgres (used when STANDALONE=false; also read by Compose postgres
# services via env_file). Config defaults match these values if unset.
# Keep localhost here for host `pnpm dev`;
# `docker-compose.yml` overrides POSTGRES_HOST/PORT for the server container.
# ---------------------------------------------------------------------------
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Max connections in the pg Pool. Optional, defaults to 10.
# DATABASE_POOL_MAX=10
# Postgres statement_timeout / idle_in_transaction_session_timeout (ms).
# Shared by the app pool and migrations. Optional, defaults to 60000 each.
# POSTGRES_STATEMENT_TIMEOUT_MS=60000
# POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
