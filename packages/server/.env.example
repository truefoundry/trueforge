# ---------------------------------------------------------------------------
# Public agent server environment
#
# Copy to .env and fill in the values. The server validates all of these at
# startup and refuses to boot on any invalid value (bad JSON, bad URL, etc.).
# ---------------------------------------------------------------------------

# HTTP port the server listens on. Optional, defaults to 8790.
PORT=8790

# Directory containing the YAML config files (models.yaml, mcp.yaml,
# skills.yaml). Optional, defaults to ./registry; relative paths are resolved
# against the working directory. The model API base URL is the base_url field
# in models.yaml; only its API key lives here.
# REGISTRY_DIR=registry

# Frontend build the server serves alongside the API. Optional, defaults to
# ../frontend/dist relative to the working directory. With no build there the
# server logs a warning and serves the API only.
# FRONTEND_DIR=../frontend/dist

# Declares the deployment topology. true (the default) asserts exactly one
# server process: Redis is never contacted and REDIS_URL is ignored even if set.
# Set it to false before running more than one replica, otherwise a cancel that
# lands on the wrong replica silently stops nothing.
SINGLE_BINARY=true

# Required when SINGLE_BINARY=false, ignored otherwise. Redis connection URL
# shared by all server replicas; carries executor peering so a cancel that lands
# on one replica reaches the replica running the turn. Use localhost for host
# `pnpm dev`; `docker-compose.yml` overrides this to redis://redis:6379 for the
# server container.
REDIS_URL=redis://localhost:6379

# Required. Default API key for the OpenAI-compatible API at models.yaml's
# base_url, sent as "Authorization: Bearer <key>" on every model request.
# Per-model overrides use MODEL_{NAME}_API_KEY with the same {NAME} rules as
# MODEL_{NAME}_HEADERS below.
MODEL_API_KEY=<your-api-key>
# MODEL_OPENAI_MAIN_GPT_5_API_KEY=<gpt-5-specific-key>

# ---------------------------------------------------------------------------
# Extra model headers (JSON objects of string values). Optional.
#
# MODEL_HEADERS is added to every model request. Per-model overrides use
# MODEL_{NAME}_HEADERS, where {NAME} is the model name from models.yaml,
# uppercased with every run of non-alphanumeric characters replaced by "_".
# Example: model "openai-main/gpt-5" -> MODEL_OPENAI_MAIN_GPT_5_HEADERS
# ---------------------------------------------------------------------------
# MODEL_HEADERS={"x-custom-header":"value"}
# MODEL_OPENAI_MAIN_GPT_5_HEADERS={"x-custom-header":"gpt-5-specific-value"}

# ---------------------------------------------------------------------------
# MCP server auth headers. Same rules as model headers: MCP_HEADERS applies to
# every MCP server in mcp.yaml; MCP_{NAME}_HEADERS overrides per server.
# Example: MCP server "github" -> MCP_GITHUB_HEADERS
# ---------------------------------------------------------------------------
# MCP_HEADERS={"Authorization":"Bearer <mcp-token>"}
# MCP_GITHUB_HEADERS={"Authorization":"Bearer <github-mcp-token>"}

# ---------------------------------------------------------------------------
# MCP OAuth (DCR). PUBLIC_BASE_URL is required — origin of the fixed callback route
# {PUBLIC_BASE_URL}/api/v1/mcp-servers/oauth/callback (not trimmed). OAUTH_CLIENT_NAME is
# the RFC 7591 client_name on the consent screen (default: truefoundry-harness).
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8790
# OAUTH_CLIENT_NAME=truefoundry-harness

# ---------------------------------------------------------------------------
# Sandbox (optional). When unset, agent specs with config.sandbox.enabled are
# rejected at session creation.
#
# SANDBOX_SETTINGS is a JSON object discriminated on "type". Supported today:
#   {"type":"daytona","snapshotName":"<daytona-snapshot>"}
# Optional daytona fields (defaults): timeoutMs (60000),
# autoStopIntervalInMinutes (5), autoArchiveIntervalInMinutes (60),
# autoDeleteIntervalInMinutes (43200).
#
# The provider API key goes in SANDBOX_API_KEY (recommended, keeps the
# credential out of the JSON blob) or as "apiKey" inside SANDBOX_SETTINGS;
# SANDBOX_API_KEY wins when both are set.
# ---------------------------------------------------------------------------
# SANDBOX_API_KEY=<daytona-api-key>
# SANDBOX_SETTINGS='{"type": "daytona", "snapshotName":"truefoundry-platform-dev-2d5edee","timeoutMs":60000,"autoStopIntervalInMinutes":5,"autoArchiveIntervalInMinutes":60,"autoDeleteIntervalInMinutes":7200}'

# Max bytes for a single file download out of the sandbox. Default 20 MB.
# SANDBOX_FILE_MAX_BYTES=20971520

# Lifetime of the signed preview URL minted for the sandbox NATS bridge
# (effectively the max duration of one turn's sandbox connection). Default 1 hour.
# SANDBOX_PREVIEW_URL_EXPIRY_SECONDS=3600

# ---------------------------------------------------------------------------
# Postgres (required). Used by the server pool and by Compose postgres
# services (via env_file). Keep localhost here for host `pnpm dev`;
# `docker-compose.yml` overrides POSTGRES_HOST/PORT for the server container.
# ---------------------------------------------------------------------------
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Max connections in the pg Pool. Optional, defaults to 10.
# DATABASE_POOL_MAX=10
