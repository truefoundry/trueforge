{
  "name": "@truefoundry/trueforge-ui",
  "version": "0.3.0-rc.1",
  "description": "TrueForge Agent Chat UI (atoms + containers) built on assistant-ui, with owned theming, presets, and swappable slots.",
  "author": "TrueFoundry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truefoundry/trueforge.git",
    "directory": "packages/trueforge-ui"
  },
  "homepage": "https://github.com/truefoundry/trueforge/tree/main/packages/trueforge-ui#readme",
  "bugs": {
    "url": "https://github.com/truefoundry/trueforge/issues"
  },
  "keywords": [
    "trueforge",
    "assistant-ui",
    "react",
    "chat",
    "agent"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui.d.ts",
      "default": "./dist/assistant-ui.js"
    },
    "./plugins/trueforge-agent-server-adapter": {
      "types": "./dist/plugins/trueforge-agent-server-adapter/index.d.ts",
      "default": "./dist/plugins/trueforge-agent-server-adapter/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "dist/styles.css",
    "src/icons/registerAgentIcons.ts"
  ],
  "scripts": {
    "prebuild": "pnpm -w run sdk:types",
    "build": "rm -rf dist && tailwindcss --input src/build-styles.css --output dist/styles.css --minify && tsup",
    "dev:watch": "pnpm run \"/^(dev:watch:js|dev:watch:css)$/\"",
    "dev:watch:js": "tsup --watch",
    "dev:watch:css": "tailwindcss --input src/build-styles.css --output dist/styles.css --watch",
    "pack:tgz": "pnpm build && pnpm pack",
    "test": "vitest run && pnpm test:package",
    "test:package": "pnpm build && node test/packageExports.smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "pnpm -w run sdk:types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint src test --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"test/**/*.{ts,tsx}\" \"*.md\" \"docs/**/*.md\" --config ../../.prettierrc"
  },
  "peerDependencies": {
    "@assistant-ui/core": "^0.2.22",
    "@assistant-ui/react": "^0.14.24",
    "@types/react": "*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/core": {
      "optional": true
    },
    "@assistant-ui/react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@assistant-ui/core": "0.2.22",
    "@assistant-ui/react": "0.14.27",
    "@openuidev/react-headless": "^0.9.4",
    "@openuidev/react-lang": "^0.2.9",
    "@openuidev/react-ui": "^0.13.2",
    "@truefoundry/assistant-ui-runtime": "0.1.26",
    "@truefoundry/trueforge-sdk": "workspace:*",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.56.0",
    "partial-json": "^0.1.7",
    "react-chartjs-2": "^5.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^6 || ^7",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "truefoundry-gateway-sdk": "^0.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild-plugin-svgr": "3.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "github-markdown-css": "^5.9.0",
    "globals": "^16.4.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.6.2",
    "react": "^19.2.4",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.9"
  }
}
