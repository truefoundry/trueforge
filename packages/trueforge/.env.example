## ---------------------------------------------------------------------------
## Public agent server environment
##
## Copy to .env and fill in the values. The server validates all of these at
## startup and refuses to boot on any invalid value (bad JSON, bad URL, etc.).
##
## Topology (STANDALONE) and NODE_ENV are set by root pnpm scripts
## (`pnpm dev`, `pnpm standalone:dev`, `pnpm start`, …). Those process env
## values win over this file. Uncomment STANDALONE below only when running the
## server package directly (e.g. `node dist/main.js` or `tsx src/main.ts`).
## ---------------------------------------------------------------------------

## Useful to configure the application data dir for different environments.
APP_DATA_DIR_SUFFIX=dev

## HTTP port the server listens on. Optional, defaults to 8790.
PORT=8790

## HTTP bind address. Optional, defaults to localhost. Production Docker images set 0.0.0.0.
# HOST=0.0.0.0

## Enable Swagger UI at /api/v1/docs. Optional, defaults to true.
# SWAGGER_ENABLED=true

## Optional override for the model catalog YAML (GET /catalog/model-providers).
## When unset, the catalog inlined at build time (catalog/model-catalog.yaml) is used.
# MODEL_CATALOG_PATH=/path/to/model-catalog.yaml

## Optional override for the MCP catalog YAML (GET /catalog/mcp-servers).
## When unset, the catalog inlined at build time (catalog/mcp-catalog.yaml) is used.
# MCP_CATALOG_PATH=/path/to/mcp-catalog.yaml

## Optional override for the skill catalog YAML (GET /catalog/skills).
## When unset, the catalog inlined at build time (catalog/skill-catalog.yaml) is used.
# SKILL_CATALOG_PATH=/path/to/skill-catalog.yaml

## Optional override for the sandbox catalog YAML (GET /catalog/sandbox-providers).
## When unset, the catalog inlined at build time (catalog/sandbox-catalog.yaml) is used.
# SANDBOX_CATALOG_PATH=/path/to/sandbox-catalog.yaml

## Optional override for the shipped web-search catalog (discovery presets).
# WEB_SEARCH_CATALOG_PATH=/path/to/web-search-catalog.yaml

## Frontend build the server serves alongside the API. Optional; defaults to
## packages/trueforge/dist/_frontend (after build) or monorepo packages/frontend/dist.
## With no build there the server logs a warning and serves the API only.
# FRONTEND_DIR=/absolute/path/to/frontend/dist

## Deployment topology: single process (true, default) uses SQLite and
## disables Redis/executor peering. Standalone is for local use only and is
## not production-safe (no login by default; keep it on localhost). false uses
## Postgres + Redis so cancels that land on the wrong replica still work.
## Prefer root scripts (`pnpm standalone:*` vs `pnpm dev` / `pnpm start`)
## over setting this here.
# STANDALONE=false

## Absolute path to the SQLite database file. Used when STANDALONE=true;
## defaults to the OS data dir from env-paths (app name "trueforge"):
##   macOS: ~/Library/Application Support/trueforge/db/db.sqlite
##   Linux: ~/.local/share/trueforge/db/db.sqlite
##   Windows: %LOCALAPPDATA%\trueforge\Data\db\db.sqlite
# SQLITE_PATH=

## Used when STANDALONE=false for the server (ignored in standalone; optional for
## controller / migrate). Redis transports are mutually exclusive — set exactly
## one of REDIS_URL, REDIS_HOST, or Sentinel.
## `docker-compose.yml` overrides this to redis://redis:6379 for the server container.
REDIS_URL=redis://localhost:6379
# Or host-based (mutually exclusive with REDIS_URL / Sentinel):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

## Redis TLS (STANDALONE=false only). Applies to data nodes and Sentinel sockets.
# REDIS_TLS_ENABLED=false
# REDIS_TLS_CA_CERT=
# REDIS_TLS_REJECT_UNAUTHORIZED=true
# REDIS_TLS_SERVERNAME=
# REDIS_TLS_CERT=
# REDIS_TLS_KEY=
# REDIS_TLS_KEY_PASSPHRASE=

## Redis Sentinel (STANDALONE=false only). Mutually exclusive with REDIS_URL / REDIS_HOST.
## When enabled, nodes + master name are required; REDIS_USERNAME/PASSWORD apply to data nodes.
# REDIS_SENTINEL_ENABLED=false
# REDIS_SENTINEL_NODES=sentinel-0:26379,sentinel-1:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=

## Redis client timeouts (STANDALONE=false only). Optional.
# REDIS_CONNECT_TIMEOUT_MS=20000
# REDIS_PING_INTERVAL_MS=5000

## Redis request/reply peering knobs (STANDALONE=false only). All optional.
## Max ms to wait for a peer executor's reply before failing with 424. Default 60000.
# REDIS_REQUEST_REPLY_TIMEOUT_MS=60000
## How often this process refreshes its peering heartbeat key. Default 5000.
# REDIS_REQUEST_REPLY_HEARTBEAT_INTERVAL_MS=5000
## TTL for reply values so abandoned reply keys are reclaimed. Default 120000.
# REDIS_REQUEST_REPLY_REPLY_TTL_MS=120000
## Sleep between reply poll attempts while waiting on a peer. Default 500.
# REDIS_REQUEST_REPLY_POLL_INTERVAL_MS=500

## Turn execution and resumable stream settings. All optional.
## Max seconds a single turn may run before cancellation. Default 600 (10 minutes).
# SERVER_EXECUTION_TIMEOUT_SECONDS=600
## Max seconds to wait for turn cancellation + connection drain on SIGTERM/SIGINT. Default 30.
# GRACEFUL_TIMEOUT_SECONDS=30
## Active stream TTL defaults to SERVER_EXECUTION_TIMEOUT_SECONDS + 300.
# TURN_STREAM_TTL_SECONDS=900
## Completed streams remain available for 5 minutes by default.
# TURN_STREAM_POST_COMPLETION_TTL_SECONDS=300
## A subscribe request stays open for 10 minutes by default.
# TURN_SUBSCRIBE_TIMEOUT_MS=600000

## Used when STANDALONE=false (ignored in standalone). Public URL of the app
## (origin plus optional pathname). Callbacks for server OIDC and MCP OAuth/DCR
## use this value. The pathname is the UI/API public prefix when a reverse proxy
## strips it (e.g. https://host/custom/proxy/path → assets/API/routes under /custom/proxy/path).
# PUBLIC_BASE_URL=http://localhost:3000

## Base URL the controller uses to reach the server API (HTTP schedule handoff).
## Dedicated controller (STANDALONE=false) and standalone loopback both use this.
## Defaults to http://localhost:$PORT; point it at the server Service in a split deployment.
# SERVER_URL=http://localhost:8790

## Service credential for controller → /api/internal/schedules.
## Required when STANDALONE=false. Standalone defaults to `trueforge-standalone` (local only).
TRUEFORGE_API_KEY=placeholder-value-please-generate-your-own

## ---------------------------------------------------------------------------
## MCP knobs.
## ---------------------------------------------------------------------------
## Client name used for Dynamic Client Registration (DCR) of MCP servers.
## This is the client name shown on authorization-server consent screens.
## Optional; defaults to truefoundry-harness.
# MCP_DCR_OAUTH_CLIENT_NAME=truefoundry-harness

## MCP client timeouts. All optional.
## Max ms for one MCP request. Default 240000 (4 minutes).
# MCP_REQUEST_TIMEOUT_MS=240000
## Max ms for an MCP transport connection. Default 30000.
# MCP_CONNECT_TIMEOUT_MS=30000
## Max bytes for one remote MCP tool-call HTTP response body (JSON / POST SSE). Default 50 MB.
# MCP_TOOL_CALL_MAX_RESPONSE_BYTES=52428800

## Outbound URL guard (MCP url / model-provider base_url). Default on; false skips it.
## Host matrix: charts/trueforge/README.md (networkPolicy).
# NETWORK_POLICY_ENABLED=true
# OUTBOUND_URL_ALLOWED_HOSTS=["localhost","127.0.0.1","llm-gateway.internal"]
# OUTBOUND_URL_BLOCKED_HOSTS=["evil.example.com"]

## ---------------------------------------------------------------------------
## Sandbox process knobs.
##
## Self-serve (not TrueFoundry mode): configure the provider via
## PUT /api/v1/settings/sandbox-providers (copy from GET /api/v1/catalogs/sandbox-providers).
## Without a configured provider, agent specs with config.sandbox.enabled (or skills) are
## rejected at session creation.
##
## TrueFoundry mode: see TRUEFOUNDRY_SANDBOX_* above (distributed config only).
## ---------------------------------------------------------------------------

## Max bytes for a single file download out of the sandbox. Default 20 MB (same as gateway).
# SANDBOX_FILE_MAX_BYTES_FOR_DOWNLOAD=20971520

## Max bytes for an HTTP request body. Default 30 MB.
## Reverse proxies must allow at least this (e.g. nginx client_max_body_size).
# MAX_REQUEST_BODY_BYTES=31457280

## ---------------------------------------------------------------------------
## Postgres (used when STANDALONE=false; also read by Compose postgres
## services via env_file). Config defaults match these values if unset.
## Local-dev credentials only (trueforge/trueforge) — change them for any shared
## or networked host. Keep localhost here for host `pnpm dev`;
## `docker-compose.yml` overrides POSTGRES_HOST/PORT for the server container.
##
## Managed Postgres (Railway, etc.): set DATABASE_URL instead of the discrete
## POSTGRES_* vars below. When DATABASE_URL is set, POSTGRES_* are ignored for
## the app connection (Compose postgres still needs POSTGRES_* for its own env).
## ---------------------------------------------------------------------------
# DATABASE_URL=postgres://trueforge:trueforge@localhost:5432/trueforge
POSTGRES_USER=trueforge
POSTGRES_PASSWORD=trueforge
POSTGRES_DB=trueforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
## Max connections in the pg Pool. Optional, defaults to 10.
# DATABASE_POOL_MAX=10
## Postgres statement_timeout / idle_in_transaction_session_timeout (ms).
## Shared by the app pool and migrations. Optional, defaults to 60000 each.
# POSTGRES_STATEMENT_TIMEOUT_MS=60000
# POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
## Postgres TLS for the pg Pool (not appended to the connection URL).
## disable | prefer | require | verify-ca | verify-full | no-verify.
## prefer/require/verify-ca/verify-full → ssl:true (Node default verify ≈ verify-full).
## no-verify → encrypt without verifying the server cert.
# POSTGRES_SSL_MODE=require
## Optional client / CA PEM paths (mTLS or custom CA).
# POSTGRES_SSL_CERT_PATH=/path/to/client.crt
# POSTGRES_SSL_KEY_PATH=/path/to/client.key
# POSTGRES_SSL_CA_PATH=/path/to/ca.crt

## Postgres schema for app tables + Kysely migration bookkeeping (default: trueforge).
# POSTGRES_SCHEMA=trueforge
## When set, automatically move TrueForge tables from the public schema to POSTGRES_SCHEMA.
# AUTOMATICALLY_MOVE_TRUEFORGE_TABLES_FROM_PUBLIC_TO_TRUEFORGE_SCHEMA=true

## ---------------------------------------------------------------------------
## OIDC (used when STANDALONE=false). All three must be set together, or all
## left unset. Unset = fixed local admin identity (no IdP) — anyone who can
## reach the server is admin. Enable OIDC for shared/public hosts. Ignored in
## standalone.
## ---------------------------------------------------------------------------
# OIDC_ISSUER_URL=https://your-tenant.example.com/oauth2/default
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
## Claim used as the user reference. Optional; defaults to "sub".
# OIDC_USER_REFERENCE_CLAIM=sub
## Claim used as the user role. Optional; defaults to "groups".
# OIDC_USER_ROLE_CLAIM=groups
## Case-sensitive role value granting admin access. Optional; defaults to "admin".
# OIDC_ADMIN_ROLE_VALUE=admin
## Comma-separated OAuth scopes for login. Optional; defaults to "openid,profile,email".
# OIDC_SCOPES=openid,profile,email
## Optional comma-separated email allowlist (exact addresses and/or * globs).
## When set, only ID tokens whose `email` claim matches an entry may sign in.
## Example: alice@acme.com,*@partner.com  Empty / unset = unrestricted.
# OIDC_ALLOWED_EMAILS=

## ---------------------------------------------------------------------------
## Mutual TLS for this process's HTTPS listener and controller→server.
## ---------------------------------------------------------------------------

## Mutual TLS for this process's HTTPS listener and controller→server. Off by default (plain HTTP).
## When true, serves HTTPS with client-cert enforcement (except /healthz) and the controller
## presents tls.crt/tls.key from MTLS_CERTS_DIR. Chart probes must use scheme HTTPS.
# MTLS_ENABLED=false
# MTLS_CERTS_DIR=/etc/tls

## ---------------------------------------------------------------------------
## TrueForge mode (STANDALONE=false only; ignored when STANDALONE=true).
## ---------------------------------------------------------------------------
# TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL=https://servicefoundry-server.truefoundry.svc.cluster.local
## Required when TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL is set. Used only to vend agent tokens for saved-agent turns.
# TRUEFOUNDRY_API_KEY=
## Max ms for non-agent ServiceFoundry HTTP calls. Default 10000.
# TRUEFOUNDRY_SERVICEFOUNDRY_HTTP_TIMEOUT_MS=10000
## Max ms for ServiceFoundry agent create/update/delete calls. Default 3000.
# TRUEFOUNDRY_SERVICEFOUNDRY_HTTP_AGENT_TIMEOUT_MS=3000
## Auth server for Sentry DSN lookup when SENTRY_ENABLED=true in TrueFoundry mode.
# TRUEFOUNDRY_AUTH_SERVER_URL=
## Optional tenantName query param for the auth-server Sentry DSN lookup.
# TRUEFOUNDRY_TENANT_NAME=

## Sentry error reporting (off by default). No-op when NODE_ENV is development/test/local.
# SENTRY_ENABLED=false
## Required when SENTRY_ENABLED=true and not in TrueFoundry mode.
# SENTRY_DSN=
## Extra tags applied on Sentry init (JSON object of strings), e.g. {"priority":"p1","team":"agent-team"}.
# SENTRY_ADDITIONAL_TAGS=

## Optional per-tenant allowlist of model provider account names (JSON object).
## Tenants omitted are unfiltered. Example: {"internal":["openai-main","anthropic-main"]}
# TRUEFOUNDRY_TENANT_ID_TO_ALLOWED_MODEL_PROVIDER_ACCOUNTS={"internal":["openai-main"]}

## Internal mutual TLS for calls to the ServiceFoundry server. When true, trueforge presents its client
## certificate (and upgrades a mesh-direct http:// peer URL to https://). Only meaningful in-cluster,
## where TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL points at the ServiceFoundry server Service directly.
# TRUEFOUNDRY_MTLS_ENABLED=false
## Directory holding the mTLS cert triple (tls.crt / tls.key / ca.crt) when TRUEFOUNDRY_MTLS_ENABLED=true.
# TRUEFOUNDRY_MTLS_CERTS_DIR=/etc/tls/truefoundry

## Built-in web search (TrueFoundry mode only). JSON object; unset disables search/fetch system tools.
# TRUEFOUNDRY_WEB_SEARCH_PROVIDER={"name":"parallel","api_key":"YOUR_PARALLEL_API_KEY"}

## Shared sandbox for all tenants (TrueFoundry mode only). PUT settings is disabled (424).
# TRUEFOUNDRY_SANDBOX_ENABLED=false
# TRUEFOUNDRY_SANDBOX_PROVIDER=daytona
## Required for daytona; optional for truefoundry.
# TRUEFOUNDRY_SANDBOX_API_KEY=
## Required when provider is truefoundry.
# TRUEFOUNDRY_SANDBOX_SERVER_URL=http://sandbox-server
## Static JSON settings (provider-specific). Daytona: snapshot + timeouts. TrueFoundry: nats_bridge_url.
# TRUEFOUNDRY_SANDBOX_SETTINGS={"snapshotName":"my-snap","timeoutMs":60000,"autoStopIntervalInMinutes":5,"autoArchiveIntervalInMinutes":60,"autoDeleteIntervalInMinutes":43200}
# TRUEFOUNDRY_SANDBOX_SETTINGS={"nats_bridge_url":"ws://nats-bridge"}
