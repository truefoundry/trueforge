{
  "name": "@truefoundry/harness-workspace",
  "private": true,
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @truefoundry/utils-core build && pnpm --filter frontend build && pnpm --filter @truefoundry/utils build",
    "clean:all": "node scripts/clean.mjs --dependencies",
    "clean": "node scripts/clean.mjs",
    "dev": "STANDALONE=false NODE_ENV=development pnpm --parallel --filter @truefoundry/utils-core --filter @truefoundry/utils --filter frontend dev",
    "dev:no-watch": "STANDALONE=false NODE_ENV=development pnpm --parallel --filter @truefoundry/utils --filter frontend dev:no-watch",
    "dev:infra": "docker compose -f docker-compose.dev.yml up",
    "dev:server:ui": "pnpm --filter frontend build && pnpm --filter @truefoundry/utils build:frontend-assets && STANDALONE=false NODE_ENV=development pnpm --parallel --filter @truefoundry/utils-core --filter @truefoundry/utils dev",
    "standalone:dev": "STANDALONE=true NODE_ENV=development pnpm --parallel --filter @truefoundry/utils-core --filter @truefoundry/utils --filter frontend dev",
    "standalone:dev:no-watch": "STANDALONE=true NODE_ENV=development pnpm --parallel --filter @truefoundry/utils --filter frontend dev:no-watch",
    "start": "STANDALONE=false NODE_ENV=production pnpm --filter @truefoundry/utils start",
    "standalone:start": "STANDALONE=true NODE_ENV=production pnpm --filter @truefoundry/utils start",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\" --cache --error-on-unmatched-pattern --config .prettierrc",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" --cache --config .prettierrc",
    "format": "prettier --write . --cache --config .prettierrc",
    "lint:ci": "eslint . --cache --cache-location .eslintcache",
    "lint": "eslint . --fix --cache --cache-location .eslintcache",
    "openapi:write": "pnpm --filter @truefoundry/utils openapi:write",
    "pack:dry": "pnpm --filter @truefoundry/utils-core pack:dry && pnpm --filter @truefoundry/utils pack:dry",
    "postinstall": "pnpm --filter @truefoundry/utils-core build:gen",
    "prepare": "husky || true",
    "sdk:generate": "bash scripts/generate-sdk.sh",
    "smoke:down": "docker compose down",
    "smoke": "docker compose up --build --wait && node -e \"Promise.all([fetch('http://127.0.0.1:8791/healthz'), fetch('http://127.0.0.1:8791/')]).then(async ([health, ui]) => { if (!health.ok) throw new Error('healthz returned ' + health.status); const html = await ui.text(); if (!ui.ok || !html.includes('id=\\\"root\\\"')) throw new Error('UI did not return its app shell'); console.log('healthz and UI OK'); })\"",
    "test:store:local": "bash scripts/test-store-local.sh",
    "test": "pnpm --filter @truefoundry/utils-core test && pnpm --filter @truefoundry/utils test && pnpm --filter frontend test",
    "typecheck": "pnpm --filter @truefoundry/utils-core typecheck && pnpm --filter @truefoundry/utils typecheck && pnpm --filter frontend typecheck",
    "ui:clean": "node ui-shots/clean.mjs",
    "ui:shot": "node ui-shots/shot.mjs"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": "prettier --write --cache --config .prettierrc"
  }
}
